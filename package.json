{
  "name": "sas-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.28",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
